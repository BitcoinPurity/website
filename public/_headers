# HTML routes: never cache stale pages at the browser or edge.
/
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

