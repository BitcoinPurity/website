{
  "name": "bitcoinpurity",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  }
}
